---
/**
 * 养成卡：把 frontmatter 里的 build 数据渲染成"一图流"面板。
 * 结构参考站长的参考图：毕业面板 / 关键共鸣链 / 天赋加点 / 武器推荐 / 声骸推荐 / 队伍搭配。
 * 任何一块没填就自动不显示，不会留空框。
 */
import { assetUrl } from '../lib/urls';

interface Props {
  build: {
    attack?: string;
    critRate?: string;
    critDamage?: string;
    energyRegen?: string;
    keyNodes: number[];
    talentOrder: string[];
    weapons: { name: string; note?: string; image?: string }[];
    echoCosts: { cost: string; main: string }[];
    echoSet?: string;
    echoFirst?: string;
    substatOrder?: string;
    teams: string[];
  };
  character: string;
}

const { build, character } = Astro.props;
const hasPanel = build.attack || build.critRate || build.critDamage || build.energyRegen;
const hasEcho = build.echoCosts.length > 0 || build.echoSet || build.echoFirst || build.substatOrder;
---
{
  (hasPanel || build.keyNodes.length > 0 || build.talentOrder.length > 0 || build.weapons.length > 0 || hasEcho || build.teams.length > 0) && (
    <section class="build-card" aria-label={`${character} 养成面板`} data-pagefind-ignore>
      <div class="build-card__grid">
        {hasPanel && (
          <div class="build-block">
            <h2 class="build-block__title">毕业面板</h2>
            <ul class="build-stats">
              {build.attack && (
                <li>
                  <span>攻击</span>
                  <strong>{build.attack}</strong>
                </li>
              )}
              {build.energyRegen && (
                <li>
                  <span>共鸣效率</span>
                  <strong>{build.energyRegen}</strong>
                </li>
              )}
              {build.critRate && (
                <li>
                  <span>暴击</span>
                  <strong>{build.critRate}</strong>
                </li>
              )}
              {build.critDamage && (
                <li>
                  <span>暴伤</span>
                  <strong>{build.critDamage}</strong>
                </li>
              )}
            </ul>
          </div>
        )}

        {build.keyNodes.length > 0 && (
          <div class="build-block">
            <h2 class="build-block__title">关键共鸣链</h2>
            <ul class="build-nodes">
              {build.keyNodes.map((node) => (
                <li>{node} 链</li>
              ))}
            </ul>
          </div>
        )}
      </div>

      {build.talentOrder.length > 0 && (
        <div class="build-block">
          <h2 class="build-block__title">天赋加点</h2>
          <ol class="build-order">
            {build.talentOrder.map((talent, index) => (
              <li>
                <span class="build-order__index">{index + 1}</span>
                {talent}
              </li>
            ))}
          </ol>
        </div>
      )}

      <div class="build-card__grid">
        {build.weapons.length > 0 && (
          <div class="build-block">
            <h2 class="build-block__title">武器推荐</h2>
            <ol class="build-weapons">
              {build.weapons.map((weapon) => (
                <li>
                  {weapon.image && (
                    <img src={assetUrl(weapon.image)} alt={weapon.name} loading="lazy" decoding="async" referrerpolicy="no-referrer" />
                  )}
                  <span class="build-weapons__name">{weapon.name}</span>
                  {weapon.note && <span class="build-weapons__note">{weapon.note}</span>}
                </li>
              ))}
            </ol>
          </div>
        )}

        {hasEcho && (
          <div class="build-block">
            <h2 class="build-block__title">声骸推荐</h2>
            {build.echoCosts.length > 0 && (
              <ul class="build-echoes">
                {build.echoCosts.map((echo) => (
                  <li>
                    <span class="build-echoes__cost">{echo.cost}</span>
                    <span>{echo.main}</span>
                  </li>
                ))}
              </ul>
            )}
            {build.echoSet && <p class="build-note">套装：{build.echoSet}</p>}
            {build.echoFirst && <p class="build-note">首位声骸：{build.echoFirst}</p>}
            {build.substatOrder && <p class="build-note">副词条：{build.substatOrder}</p>}
          </div>
        )}
      </div>

      {build.teams.length > 0 && (
        <div class="build-block">
          <h2 class="build-block__title">队伍搭配</h2>
          <ul class="build-teams">
            {build.teams.map((team) => (
              <li>{team}</li>
            ))}
          </ul>
        </div>
      )}
    </section>
  )
}
