---
import { characterPath, formatDate, guidePath, type Guide } from '../lib/characters';
import { assetUrl } from '../lib/urls';

interface Props {
  guide: Guide;
  /** 角色页里不需要重复显示角色标签 */
  showCharacter?: boolean;
}

const { guide, showCharacter = true } = Astro.props;
const { title, character, date, tags, version, author, cover } = guide.data;
---

<article class="card">
  {
    cover && (
      <a class="card__cover" href={guidePath(guide)} tabindex="-1" aria-hidden="true">
        <img src={assetUrl(cover)} alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
      </a>
    )
  }
  <h3 class="card__title"><a href={guidePath(guide)}>{title}</a></h3>
  <p class="card__meta">
    {
      showCharacter && (
        <a class="chip chip--accent" href={characterPath(character)}>
          {character}
        </a>
      )
    }
    {version && <span class="chip">版本 {version}</span>}
    <time datetime={date.toISOString()}>{formatDate(date)}</time>
    {author && <span>by {author}</span>}
  </p>
  {
    tags.length > 0 && (
      <ul class="chips">
        {tags.slice(0, 4).map((tag) => (
          <li class="chip">{tag}</li>
        ))}
      </ul>
    )
  }
</article>
