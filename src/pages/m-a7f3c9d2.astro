---
/**
 * 站长的临时管理页（不在任何导航里，也不进搜索索引）。
 *
 * ⚠️ 这不是真正的权限系统：站点是纯静态的，任何人都能打开这个地址。
 * 真正的门是 GitHub 权限 —— 下面的"编辑 / 删除"只是跳转到 GitHub 的对应页面，
 * 没有仓库写权限的人点了也改不了任何东西。
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../components/BaseLayout.astro';
import { newFileUrl, repoFileUrl } from '../config';
import { allCharacters, formatDate, sortTeams, teamsOfCharacter } from '../lib/characters';
import { withBase } from '../lib/urls';

const teams = await getCollection('teams');
const teamList = sortTeams(teams);
const characters = allCharacters(teams);
---

<BaseLayout title="管理（私有）" description="站点内容管理入口。" noindex>
  <section class="page-head">
    <p class="eyebrow">私有页面 · 不对外</p>
    <h1>内容管理</h1>
    <p class="lede" style="max-width: 62ch;">
      下面每个「编辑 / 删除」都会跳到 GitHub 对应页面，<strong>只有仓库所有者点了才有效</strong>。
      日常增删改建议用桌面上的「本地管理台」。
    </p>
    <div class="form-actions" style="margin-top: 1rem;">
      <a class="btn" href={newFileUrl('teams')} target="_blank" rel="noopener">新建配队</a>
      <a class="btn btn--ghost" href={withBase('/teams/')}>查看配队页</a>
    </div>
  </section>

  <section class="section" aria-labelledby="by-character">
    <div class="section__head">
      <h2 id="by-character">按角色</h2>
      <span class="muted">每个角色名下的配队</span>
    </div>
    {
      characters.length === 0 ? (
        <p class="empty">还没有内容。</p>
      ) : (
        <div class="character-grid">
          {characters.map((character) => (
            <div class="character-block">
              <h3>{character.name}</h3>
              <ul>
                {teamsOfCharacter(teams, character.name).map((team) => (
                  <li>
                    <a href={withBase(`/teams/${team.id}/`)}>{team.data.teamName}</a>
                    <a href={repoFileUrl('teams', team.id, 'edit')} target="_blank" rel="noopener">编辑</a>
                    <a class="danger" href={repoFileUrl('teams', team.id, 'delete')} target="_blank" rel="noopener">删除</a>
                  </li>
                ))}
                {teamsOfCharacter(teams, character.name).length === 0 && <li class="muted">暂无</li>}
              </ul>
            </div>
          ))}
        </div>
      )
    }
  </section>

  <section class="section" aria-labelledby="manage-teams">
    <div class="section__head">
      <h2 id="manage-teams">配队推荐（{teamList.length}）</h2>
      <a href={withBase('/teams/')}>查看页面 →</a>
    </div>
    {
      teamList.length === 0 ? (
        <p class="empty">还没有配队。</p>
      ) : (
        <div class="table-wrap">
          <table class="table">
            <thead>
              <tr>
                <th>配队</th>
                <th>核心 · 体系</th>
                <th>日期</th>
                <th>操作</th>
              </tr>
            </thead>
            <tbody>
              {teamList.map((team) => (
                <tr>
                  <td>
                    <a href={withBase(`/teams/${team.id}/`)}>{team.data.teamName}</a>
                  </td>
                  <td>
                    {team.data.coreCharacter} · {team.data.element}
                  </td>
                  <td>{formatDate(team.data.date)}</td>
                  <td class="table__actions">
                    <a href={repoFileUrl('teams', team.id, 'edit')} target="_blank" rel="noopener">编辑</a>
                    <a class="danger" href={repoFileUrl('teams', team.id, 'delete')} target="_blank" rel="noopener">删除</a>
                    <a href={repoFileUrl('teams', team.id, 'blob')} target="_blank" rel="noopener">源文件</a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )
    }
  </section>
</BaseLayout>
