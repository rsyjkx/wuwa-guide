---
import { getCollection } from 'astro:content';
import BaseLayout from '../../components/BaseLayout.astro';
import GuideCard from '../../components/GuideCard.astro';
import { sortGuides } from '../../lib/characters';
import { withBase } from '../../lib/urls';

const guides = sortGuides(await getCollection('guides'));
---

<BaseLayout title="全部攻略" description="《鸣潮》全部单角色攻略列表。" noindex>
  <section class="page-head">
    <p class="eyebrow">攻略</p>
    <h1>全部单角色攻略</h1>
    <p class="lede">
      共 {guides.length} 篇。想按角色查看，可以从<a href={withBase('/characters/')}>角色列表</a>进入；想全文搜索，用<a
        href={withBase('/search/')}>搜索页</a
      >。
    </p>
  </section>

  {
    guides.length === 0 ? (
      <p class="empty">还没有攻略，欢迎到<a href={withBase('/submit/')}>投稿页</a>提交第一篇。</p>
    ) : (
      <div class="grid">
        {guides.map((guide) => (
          <GuideCard guide={guide} />
        ))}
      </div>
    )
  }
</BaseLayout>
