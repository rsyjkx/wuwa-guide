---
import { getCollection } from 'astro:content';
import BaseLayout from '../../components/BaseLayout.astro';
import TeamCard from '../../components/TeamCard.astro';
import { allCharacters, teamsOfCharacter } from '../../lib/characters';
import { withBase } from '../../lib/urls';

export async function getStaticPaths() {
  const teams = await getCollection('teams');
  return allCharacters(teams).map((character) => ({
    params: { character: character.name },
    props: { name: character.name },
  }));
}

const { name } = Astro.props;
const teams = await getCollection('teams');
const relatedTeams = teamsOfCharacter(teams, name);
---

<BaseLayout title={`${name} 配队推荐`} description={`以 ${name} 为核心的《鸣潮》配队推荐。`} noindex>
  <section class="page-head">
    <p class="eyebrow">角色</p>
    <h1>{name}</h1>
    <p class="lede">以该角色为核心的配队 {relatedTeams.length} 支</p>
    <div class="form-actions" style="margin-top: 1rem;">
      <a class="btn btn--ghost" href={withBase('/characters/')}>全部角色</a>
      <a class="btn btn--ghost" href={withBase('/submit/')}>投稿配队</a>
    </div>
  </section>

  <section class="section" aria-labelledby="teams-title">
    <div class="section__head">
      <h2 id="teams-title">相关配队</h2>
      <span class="muted">按核心角色匹配</span>
    </div>
    {
      relatedTeams.length === 0 ? (
        <p class="empty">还没有以 {name} 为核心的配队。</p>
      ) : (
        <div class="grid">
          {relatedTeams.map((team) => (
            <TeamCard team={team} />
          ))}
        </div>
      )
    }
  </section>
</BaseLayout>
