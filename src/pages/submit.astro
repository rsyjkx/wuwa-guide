---
import BaseLayout from '../components/BaseLayout.astro';
import { SITE } from '../config';

const EMAIL = '3587287943@qq.com';

const mailSubject = `【投稿】鸣潮攻略 / 配队 - 你的昵称`;

const mailBody = [
  '【角色攻略】',
  '1. 角色：',
  '2. 角色毕业面板：',
  '3. 武器推荐：',
  '4. 声骸搭配：',
  '5. 配队推荐：',
  '6. 命座简介（1–6 命逐个写）：',
  '7. 技能加点优先级（共鸣技能 / 共鸣解放 / 共鸣回路 / 常态攻击 / 变奏技能）：',
  '',
  '【配队攻略】',
  '1. 配队名称：',
  '2. 核心角色：',
  '3. 角色及其武器：',
  '4. 声骸选择：',
  '5. 配队操作流程视频链接（请标明出处）：',
  '',
  '【可选】',
  '作者昵称：',
  '适用版本：',
  '图片链接（一行一个）：',
].join('\n');

const mailto = `mailto:${EMAIL}?subject=${encodeURIComponent(mailSubject)}&body=${encodeURIComponent(mailBody)}`;
---

<BaseLayout title="投稿" description={`投稿请发送邮件到 ${EMAIL}，经站长审核后发布。`}>
  <section class="page-head">
    <p class="eyebrow">投稿</p>
    <h1>投稿请发邮件</h1>
    <p class="lede" style="max-width: 62ch;">
      本站不提供在线投稿表单，也不需要你注册任何账号。把内容发到下面这个邮箱，站长人工审核后发布。
    </p>
  </section>

  <section class="notice notice--ok" style="margin-bottom: 1.2rem;">
    <p style="margin: 0 0 0.5rem;">投稿邮箱</p>
    <p style="margin: 0 0 0.8rem; font-size: 1.35rem; font-weight: 700; letter-spacing: 0.02em;">
      <a href={mailto}>{EMAIL}</a>
    </p>
    <div class="form-actions">
      <a class="btn" href={mailto}>用邮件客户端写一封</a>
      <button class="btn btn--ghost" type="button" data-copy-email>复制邮箱地址</button>
      <button class="btn btn--ghost" type="button" data-copy-template>复制填写模板</button>
    </div>
    <p class="hint" style="margin: 0.6rem 0 0;" data-copy-status role="status" aria-live="polite"></p>
  </section>

  <h2>角色攻略写这 6 个章节</h2>
  <ol class="prose" style="max-width: 62ch;">
    <li><strong>角色毕业面板</strong>：攻击力 / 暴击 / 暴伤 / 共鸣效率的参考区间</li>
    <li><strong>武器推荐</strong>：首选 / 替代 / 精炼建议</li>
    <li><strong>声骸搭配</strong>：套装、主词条、副词条优先级</li>
    <li><strong>配队推荐</strong>：推荐队友、定位、对轴要点</li>
    <li><strong>命座简介</strong>：1–6 命逐个写，各自提升什么、值不值得抽</li>
    <li>
      <strong>技能加点优先级</strong>：五个技能 —— 共鸣技能、共鸣解放、共鸣回路、常态攻击、变奏技能，按优先级从高到低排
    </li>
  </ol>

  <h2>配队攻略写这 2 个章节 + 一段视频</h2>
  <ol class="prose" style="max-width: 62ch;">
    <li><strong>角色及其武器</strong>：每个成员用什么武器、为什么</li>
    <li><strong>声骸选择</strong>：每个成员套装与词条，可写替代方案</li>
    <li><strong>配队操作流程视频链接</strong>：附上手法的视频，并<strong>标明出处</strong>（作者 / UP 主）</li>
  </ol>

  <h2>可选内容</h2>
  <ul class="prose" style="max-width: 62ch;">
    <li>作者昵称（会显示在文章上，不写就匿名）</li>
    <li>适用游戏版本</li>
    <li>图片链接：先传到图床或 QQ 空间等，把<strong>图片地址</strong>贴进邮件</li>
    <li>视频链接：B 站 / YouTube 链接即可</li>
  </ul>

  <h2>几点说明</h2>
  <ul class="prose" style="max-width: 62ch;">
    <li>审核通常 1–3 天，采纳与否都会回复。</li>
    <li>图片、视频只收链接，不收附件（附件容易被邮箱拦截）。</li>
    <li>请不要发送账号密码等私人信息，邮件只用于发布内容。</li>
    <li>内容会做少量格式调整（分段、标点），不会改你的观点。</li>
  </ul>

  <p class="hint" style="margin-top: 1.5rem;">
    站内也可以直接看
    <a href={`${import.meta.env.BASE_URL}guides/`}>全部攻略</a>、
    <a href={`${import.meta.env.BASE_URL}teams/`}>配队推荐</a>。
  </p>
</BaseLayout>

<script>
  const email = '3587287943@qq.com';
  const template = `【角色攻略】
1. 角色：
2. 角色毕业面板：
3. 武器推荐：
4. 声骸搭配：
5. 配队推荐：
6. 命座简介（1–6 命逐个写）：
7. 技能加点优先级（共鸣技能 / 共鸣解放 / 共鸣回路 / 常态攻击 / 变奏技能）：

【配队攻略】
1. 配队名称：
2. 核心角色：
3. 角色及其武器：
4. 声骸选择：
5. 配队操作流程视频链接（请标明出处）：

【可选】
作者昵称：
适用版本：
图片链接（一行一个）：`;

  const status = document.querySelector<HTMLElement>('[data-copy-status]');

  async function copy(text: string, label: string) {
    try {
      await navigator.clipboard.writeText(text);
      if (status) status.textContent = `${label}已复制`;
    } catch {
      // 剪贴板不可用时退化成选中提示
      if (status) status.textContent = `复制失败，请手动选择：${text.slice(0, 40)}…`;
    }
  }

  document.querySelector('[data-copy-email]')?.addEventListener('click', () => {
    void copy(email, '邮箱地址');
  });

  document.querySelector('[data-copy-template]')?.addEventListener('click', () => {
    void copy(template, '模板');
  });
</script>
