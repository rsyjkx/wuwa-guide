---
import { getCollection } from 'astro:content';
import BaseLayout from '../../components/BaseLayout.astro';
import TeamCard from '../../components/TeamCard.astro';
import { sortTeams } from '../../lib/characters';
import { withBase } from '../../lib/urls';

const teams = sortTeams(await getCollection('teams'));

/** 标签：队伍自己的 tags + 体系（都作为筛选维度，去重排序） */
const tagSet = new Set<string>();
for (const team of teams) {
  for (const tag of team.data.tags) tagSet.add(tag);
  if (team.data.element) tagSet.add(team.data.element);
}
const allTags = [...tagSet].sort((a, b) => a.localeCompare(b, 'zh-CN'));

/** 可筛选的角色：只统计"成员"（下位替代不算） */
const charSet = new Set<string>();
for (const team of teams) {
  for (const member of team.data.members) charSet.add(member.name);
}
const allCharacters = [...charSet].sort((a, b) => a.localeCompare(b, 'zh-CN'));
---

<BaseLayout title="配队推荐" description="《鸣潮》配队推荐，按标签（体系 / 属性）和队伍角色筛选。" noindex>
  <section class="page-head">
    <p class="eyebrow">配队</p>
    <h1>配队推荐</h1>
    <p class="lede">共 {teams.length} 支队伍。点标签或角色即可筛选；下位替代不参与角色筛选。</p>
  </section>

  {
    teams.length === 0 ? (
      <p class="empty">还没有配队。</p>
    ) : (
      <>
        <section class="filter" data-filter aria-label="筛选">
          <div class="filter__row">
            <span class="filter__label">标签</span>
            <div class="filter__chips" data-filter-tags>
              {allTags.map((tag) => (
                <button type="button" class="chip filter__chip" data-value={tag}>
                  {tag}
                </button>
              ))}
            </div>
          </div>
          <div class="filter__row">
            <span class="filter__label">角色</span>
            <div class="filter__chips" data-filter-chars>
              {allCharacters.map((name) => (
                <button type="button" class="chip filter__chip" data-value={name}>
                  {name}
                </button>
              ))}
            </div>
          </div>
          <div class="filter__row">
            <span class="filter__label"></span>
            <button type="button" class="btn btn--ghost" data-filter-reset>清除筛选</button>
            <span class="muted" data-filter-count>
              显示 {teams.length} / {teams.length}
            </span>
          </div>
        </section>

        <div class="grid" data-team-grid>
          {teams.map((team) => (
            <TeamCard team={team} />
          ))}
        </div>
        <p class="empty" data-filter-empty hidden>没有符合条件（标签和角色同时满足）的配队。</p>
      </>
    )
  }
</BaseLayout>

<script>
  const root = document.querySelector<HTMLElement>('[data-filter]');
  const grid = document.querySelector<HTMLElement>('[data-team-grid]');
  const empty = document.querySelector<HTMLElement>('[data-filter-empty]');
  const count = document.querySelector<HTMLElement>('[data-filter-count]');

  if (root && grid) {
    const cards = [...grid.querySelectorAll<HTMLElement>('.card')];
    const selected = { tag: new Set<string>(), char: new Set<string>() };

    const readList = (card: HTMLElement, key: string) =>
      (card.dataset[key] ?? '').split('|').filter(Boolean);

    const apply = () => {
      let visible = 0;
      for (const card of cards) {
        const tags = readList(card, 'tags');
        const chars = readList(card, 'chars');
        const tagOk = selected.tag.size === 0 || [...selected.tag].some((tag) => tags.includes(tag));
        const charOk = selected.char.size === 0 || [...selected.char].some((name) => chars.includes(name));
        const show = tagOk && charOk;
        card.hidden = !show;
        if (show) visible += 1;
      }
      if (count) count.textContent = `显示 ${visible} / ${cards.length}`;
      if (empty) empty.hidden = visible !== 0;
      for (const chip of root.querySelectorAll<HTMLElement>('[data-value]')) {
        const group = chip.closest('[data-filter-tags]') ? 'tag' : 'char';
        chip.classList.toggle('is-active', selected[group].has(chip.dataset.value ?? ''));
      }
    };

    root.addEventListener('click', (event) => {
      const chip = (event.target as HTMLElement).closest<HTMLElement>('[data-value]');
      if (chip) {
        const group = chip.closest('[data-filter-tags]') ? 'tag' : 'char';
        const value = chip.dataset.value ?? '';
        if (selected[group].has(value)) selected[group].delete(value);
        else selected[group].add(value);
        apply();
        return;
      }
      if ((event.target as HTMLElement).closest('[data-filter-reset]')) {
        selected.tag.clear();
        selected.char.clear();
        apply();
      }
    });
  }
</script>
