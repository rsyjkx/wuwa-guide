---
import BaseLayout from '../components/BaseLayout.astro';
import { withBase } from '../lib/urls';
---

<BaseLayout title="搜索" description="搜索《鸣潮》配队推荐与角色面板。" noindex>
  <section class="page-head">
    <p class="eyebrow">搜索</p>
    <h1>搜索配队</h1>
    <p class="lede">
      索引在构建时生成、在浏览器本地检索，不会把关键词发到任何服务器。可以用「角色」和「配队体系」两个下拉筛选缩小范围。
    </p>
  </section>

  <div class="search-box">
    <!-- Pagefind 组件 UI：所有组件默认共享 default 实例，会自动联动 -->
    <pagefind-config preload></pagefind-config>
    <pagefind-input placeholder="搜索角色名、配队名、武器或声骸…"></pagefind-input>

    <div class="search-filters">
      <pagefind-filter-dropdown filter="character" label="按角色筛选" sort="alphabetical"></pagefind-filter-dropdown>
      <pagefind-filter-dropdown filter="team-element" label="按配队体系筛选" sort="alphabetical"></pagefind-filter-dropdown>
    </div>

    <pagefind-summary></pagefind-summary>
    <pagefind-results></pagefind-results>
  </div>

  <p class="notice pagefind-note" data-pagefind-missing hidden>
    本地开发模式（<code>npm run dev</code>）不会生成搜索索引，所以搜索框暂时没有结果。想看真实搜索效果请执行
    <code>npm run build && npm run preview</code>。线上站点不受影响。
  </p>

  <script>
    // dev 模式没有 Pagefind 索引，给个提示；逻辑在 src/scripts/search-notice.ts
    import '../scripts/search-notice';
  </script>

  <link slot="head" rel="stylesheet" href={withBase('/pagefind/pagefind-component-ui.css')} />
  <script is:inline type="module" src={withBase('/pagefind/pagefind-component-ui.js')}></script>
</BaseLayout>
